# Credenciais do LiveKit Cloud (cloud.livekit.io -> Settings -> Keys).
# Copie para .env na raiz do projeto e preencha. O .env é ignorado pelo git.
# Sem estas variáveis o app roda normalmente, só sem voz nem tela.

# Project URL do dashboard, COM o esquema wss://
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=

# Prefixo do nome da sala. Dev e produção costumam usar o mesmo projeto LiveKit;
# sem prefixos distintos os dois caem na MESMA sala. Use "dev" localmente e
# deixe em branco (ou "prod") no Railway.
LIVEKIT_ROOM_PREFIX=dev
